<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/chrome_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <!-- Logo Google chuẩn phong cách Chrome -->
        <TextView
            android:id="@+id/tvGoogleLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google"
            android:textSize="44sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="28dp" />

        <!-- Ô Tìm kiếm lớn kiểu viên thuốc tròn giữa màn hình -->
        <LinearLayout
            android:id="@+id/layoutCentralSearch"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_chrome_search_box"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="18sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tìm kiếm hoặc nhập URL"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Lưới phím tắt tròn chuẩn Chrome New Tab -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>

