<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:background="?attr/selectableItemBackground">

    <!-- Icon loại media -->
    <TextView
        android:id="@+id/tvFileEmoji"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="🎬"
        android:textSize="22sp"
        android:layout_marginEnd="10dp" />

    <!-- Tên tệp và thông tin dung lượng / ngày giờ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Video_20261111.mp4"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tvFileInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15.20 MB • Vừa xong"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Nút Chia sẻ 📤 -->
    <TextView
        android:id="@+id/btnShareFile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="📤"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <!-- Nút Xoá tệp 🗑️ -->
    <TextView
        android:id="@+id/btnDeleteFile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="🗑️"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>

