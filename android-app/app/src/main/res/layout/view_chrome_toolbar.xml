<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/chrome_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Nút Trang chủ 🏠 -->
        <TextView
            android:id="@+id/btnHome"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="🏠"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Hộp Omnibox bo tròn kiểu viên thuốc -->
        <LinearLayout
            android:id="@+id/layoutOmnibox"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chrome_omnibox"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- Biểu tượng ổ khoá bảo mật 🔒 -->
            <TextView
                android:id="@+id/tvSecurityLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <!-- Tên miền / Tiêu đề rút gọn -->
            <TextView
                android:id="@+id/tvOmniboxUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tìm kiếm hoặc nhập URL"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Nút Trình chuyển đổi Thẻ [ N ] -->
        <FrameLayout
            android:id="@+id/btnTabSwitcher"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chrome_tab_count"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/tvTabCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Nút Menu 3 Chấm ⋮ -->
        <TextView
            android:id="@+id/btnOverflowMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="⋮"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- Thanh tiến độ tải trang mỏng màu xanh sát đáy toolbar -->
    <ProgressBar
        android:id="@+id/pbWebProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_gravity="bottom"
        android:progressDrawable="@drawable/bg_progress_bar"
        android:max="100"
        android:visibility="gone" />

</FrameLayout>

