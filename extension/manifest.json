{
  "manifest_version": 3,
  "name": "Download Video & Image",
  "version": "1.0.0",
  "description": "Tải video và hình ảnh trên mọi trang web chỉ với một cú bấm",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/media-utils.js",
        "content/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Download Video & Image"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

